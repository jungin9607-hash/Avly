# 이 파일을 .env 로 복사해서 사용합니다. (.env 는 git 에 올리지 않습니다)

# 요청을 허용할 프론트엔드 주소 (쉼표로 구분)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 업로드한 파일의 URL 을 만들 때 쓰는 백엔드 주소
PUBLIC_BASE_URL=http://localhost:8000

# 업로드 파일 저장 폴더 (상대 경로는 backend/ 기준)
UPLOAD_DIR=uploads

# 영상 업로드 최대 용량 (MB)
MAX_UPLOAD_SIZE_MB=200

# 허용할 영상 확장자 (쉼표로 구분)
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm

# Mock 분석이 완료되기까지 걸리는 시간 (초)
MOCK_ANALYSIS_DELAY_SECONDS=3
