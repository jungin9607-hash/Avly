# 이 파일을 .env 로 복사해서 사용합니다. (.env 는 git 에 올리지 않습니다)

# 요청을 허용할 프론트엔드 주소 (쉼표로 구분)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 업로드한 파일의 URL 을 만들 때 쓰는 백엔드 주소
PUBLIC_BASE_URL=http://localhost:8000

# 업로드 파일 저장 폴더 (상대 경로는 backend/ 기준)
UPLOAD_DIR=uploads

# 영상 업로드 최대 용량 (MB)
MAX_UPLOAD_SIZE_MB=200

# 허용할 영상 확장자 (쉼표로 구분)
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi

# 어느 DB 에 연결할지는 이 한 줄로 정한다. docker compose 도 이 값을 그대로 쓴다.
#
# (1) 팀 공용 DB (Supabase, Session Pooler): 팀원이 같은 데이터(판례 저장분, 분석 결과)를 같이 본다. QA 는 이쪽을 쓴다.
#     <비밀번호> 는 팀 공유 채널에서 받아 .env 에만 적는다. 특수문자(@ : / # 등)가 있으면 URL 인코딩(%40 등)해야 한다.
#     공용 DB 에는 테스트 영상의 분석 결과만 쌓인다. 개인정보가 든 실제 영상은 (2)로 시험한다.
# (2) 내 PC 에서만 쓰는 로컬 DB: 아래 주소로 바꾸면 docker compose 의 db 서비스에 연결되고, 시작할 때 스키마를 자동으로 만든다.
#     DATABASE_URL=postgresql://postgres:avly@db:5432/avly
DATABASE_URL=postgresql://postgres.mtcebgsyuqhbbkhkaouw:<비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# --- v0.4 ---
# 시작할 때 migrations/*.sql 을 자동 적용할지. 정하지 않으면: 로컬 db 서비스(주소의 호스트가 db)에서만 켜고, 공용 DB 는 건드리지 않는다.
# 공용 DB 의 구조를 바꿔야 할 때는 한 사람이 팀에 알린 뒤  docker compose exec backend python -m app.migrate --apply  로 적용한다.
# AUTO_MIGRATE=false
# 영상 서명 URL 에 쓰는 비밀값. 운영에서는 길고 무작위인 값으로 반드시 바꾼다.
APP_SECRET=dev-only-secret-change-me
# 세션 길이(시간). 이 시간이 지나면 분석 결과를 지우고 원본 영상과 (저장 동의 없는) 비식별 영상을 삭제한다
SESSION_TTL_HOURS=2
# 영상 저장에 동의한 사용자의 비식별 영상을 보관하는 날 수
RETENTION_DAYS=90
CASE_COMPARE=auto                # 판례 비교: auto(실제 엔진+OpenAI 키가 있으면 AI) | ai | rule(규칙만, AI 없음)
UNSUPPORTED_RETENTION_HOURS=24   # 차대차가 아닌 영상은 저장 동의가 있어도 이 시간 뒤 삭제

# worker 설정
# 분석 엔진: fake(키 없이 전체 흐름 시험) | replay(저장된 결과 재생) | avly(실제 분석, OPENAI_API_KEY 필요)
ENGINE=avly
# 비식별화: yolo(번호판·사람 탐지, 운영) | dev_copy(개발용: 가리지 않고 복사만 한다. 운영 금지)
REDACTION=yolo

# 실제 분석(ENGINE=avly)에 필요한 키 (값은 여기에만 적고 git 에 올리지 않는다)
# OPENAI_API_KEY=
# law_api=
